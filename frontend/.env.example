# URL of the running FastAPI backend (bharatnatyam_backend), no trailing
# slash. Copy this file to .env for local dev; on Vercel/Netlify set it in
# the project's environment variables instead (it's baked in at build time).
VITE_API_URL=http://localhost:8000

# Optional: request timeout (ms) and client-side upload limit (MB).
# VITE_REQUEST_TIMEOUT_MS=90000
# VITE_MAX_UPLOAD_MB=10
